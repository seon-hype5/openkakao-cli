            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "openkakao-synthetic-fixture"
            VALUE "OriginalFilename", "fixture.exe"
            VALUE "ProductName", "OPENKAKAO_SYNTHETIC_FIXTURE_ONLY"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
